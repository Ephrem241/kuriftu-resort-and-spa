# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local working docs (not published)
/design/
/prompts/
/AGENTS.md

# agent skills (local tooling)
/.agents/skills/
/.claude/skills/
/agent/skills/

# playwright mcp screenshots
/.playwright-mcp/

# content migration: regenerable snapshots and outputs
/migration/node_modules/
/migration/extracted/
/migration/transformed/
.env.local
