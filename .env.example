# Canonical list of environment variables. Copy to .env.local and fill in.

# TravelBook group booking engine (public: it is the "Reserve" link).
# Full URL including Kuriftu's group ids, e.g. the live site's Reserve link.
NEXT_PUBLIC_BOOKING_ENGINE_URL=

# Sanity (public identifiers).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-21

# Sanity secrets (server only, never NEXT_PUBLIC_).
# Viewer token for the private dataset.
SANITY_API_READ_TOKEN=
# Shared secret of the Sanity revalidate webhook (POST /api/revalidate).
SANITY_REVALIDATE_SECRET=

# Public origin of the site, for canonical URLs, sitemap.xml and JSON-LD.
# Required for production builds, e.g. https://www.kurifturesorts.com
NEXT_PUBLIC_SITE_URL=

# Enquiries (server only, never NEXT_PUBLIC_).
# Sanity robot token with Editor rights, used only by POST /api/enquiry.
SANITY_API_WRITE_TOKEN=
# Resend API key and a sender on a domain verified in Resend,
# e.g. "Kuriftu Website <enquiries@kurifturesorts.com>". If either is
# missing, enquiries are still stored but no email is sent.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
# Optional: deployed Studio URL, for the "Open in Studio" link in emails.
SANITY_STUDIO_URL=

# PostHog product analytics (public by design: the project API key, not a
# personal key). Loaded only after the guest accepts the consent banner.
# Leave the key empty to disable analytics and hide the banner.
NEXT_PUBLIC_POSTHOG_KEY=
# https://eu.i.posthog.com or https://us.i.posthog.com, matching the project.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
