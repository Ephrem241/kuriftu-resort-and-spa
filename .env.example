# Canonical list of environment variables. Copy to .env.local and fill in.

# TravelBook group booking engine (public: it is the "Reserve" link).
# Full URL including Kuriftu's group ids, e.g. the live site's Reserve link.
NEXT_PUBLIC_BOOKING_ENGINE_URL=

# Sanity (public identifiers). Tokens are added when the data layer needs them.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-21
